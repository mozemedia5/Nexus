# Nexus / Liverton Store Environment Contract

# Shopify Storefront API (PUBLIC access token only; embedded in the browser for catalog & cart)
# Use store's domain without https:// (e.g., nexus-store.myshopify.com)
# Never put a private Storefront API token or SHOPIFY_ADMIN_ACCESS_TOKEN in either token variable.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Shopify Admin API Credentials (Server-only for protected order tracking lookup)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Firebase Client Configuration JSON (public browser configuration)
VITE_FIREBASE_CONFIG_JSON=

# Firebase Admin Service Account JSON (Server-only)
FIREBASE_SERVICE_ACCOUNT_JSON=

# One-time bootstrap identity for the first verified Firebase superadministrator.
# The account must already exist in Firebase Authentication and have a verified email.
# After the first successful admin session, the server assigns a protected custom claim.
NEXUS_INITIAL_ADMIN_EMAIL=

# Gemini Shopping Assistant (Server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated fallbacks tried when the configured model is unavailable or busy.
# Example: gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview

# Cloudinary Media Upload Signer (Server-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=


# Liverton Store / Shopify Storefront API
# Use the store's myshopify.com domain, without https://
VITE_SHOPIFY_STORE_DOMAIN
# Public Storefront API token only; never use an Admin API secret in the browser
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN
# Keep aligned with the Storefront API version supported by the store
VITE_SHOPIFY_API_VERSION=2025-10

# Existing optional analytics placeholders referenced by client/index.html
VITE_ANALYTICS_ENDPOINT
VITE_ANALYTICS_WEBSITE_ID

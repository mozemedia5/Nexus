rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // The server uses Firebase Admin SDK for this collection. Clients must never read or write roles.
    match /nexus_admins/{adminId} {
      allow read, write: if false;
    }

    // Customer profiles remain private to their owner and server-authorized admins.
    match /nexus_users/{userId} {
      allow read, update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Campaigns are readable publicly; only trusted custom-claim admins can change them.
    match /nexus_campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reserved Cari conversations are accessed by server endpoints using Firebase Admin SDK.
    match /nexus_cari_conversations/{conversationId} {
      allow read, write: if false;
    }
  }
}

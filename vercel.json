{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/chat.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/cloudinary/signature",
      "destination": "/api/cloudinary-router?action=signature"
    },
    {
      "source": "/api/cloudinary/cari-signature",
      "destination": "/api/cloudinary-router?action=cari-signature"
    },
    {
      "source": "/api/cloudinary/session",
      "destination": "/api/cloudinary-router?action=session"
    },
    {
      "source": "/api/cloudinary/session-cleanup",
      "destination": "/api/cloudinary-router?action=session-cleanup"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
